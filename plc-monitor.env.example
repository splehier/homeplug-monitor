# Network interface on the same layer-2 segment as the powerline adapter.
PLC_IFACE=enp3s0

# Poll cadence and plctool read timeout.
PLC_POLL_INTERVAL=60
PLC_TIMEOUT_MS=1000

# Link expectations. MARGINAL is the rate below which a link counts as weak;
# MAX is only a fallback now: the gauge auto-scales to the last 24h of rates.
PLC_EXPECTED_STATIONS=1
PLC_MARGINAL_MBPS=50
PLC_MAX_MBPS=1300

# History. Stored as SQLite, one row per poll, pruned to the retention window.
# 15s polling for 14 days is roughly 80k rows and about 3 MB.
PLC_DB_PATH=/data/plc-history.db
PLC_RETENTION_DAYS=14

# Web service.
PLC_HTTP_HOST=0.0.0.0
PLC_HTTP_PORT=8087

# MQTT. Leave PLC_MQTT_HOST empty to run without MQTT.
PLC_MQTT_HOST=
PLC_MQTT_PORT=1883
PLC_MQTT_USER=
PLC_MQTT_PASS=
PLC_MQTT_PREFIX=plcmon/powerline
PLC_MQTT_DISCOVERY_PREFIX=homeassistant
PLC_DEVICE_NAME=Powerline link
PLC_DEVICE_ID=plc_powerline
# Optional label on the Home Assistant device card, e.g. TP-Link or Devolo.
PLC_DEVICE_MANUFACTURER=

# Polls between firmware/MAC reads. These do not change between reboots, so
# reading them every poll just doubles the traffic to the adapter.
PLC_VERSION_EVERY=60

# Optional overrides.
#PLC_PLCTOOL=/usr/local/bin/plctool
#PLC_LOG_LEVEL=INFO
